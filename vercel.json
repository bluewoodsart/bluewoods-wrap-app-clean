{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "redirects": [
    {
      "source": "/go/david",
      "destination": "https://master-front-end-blue-woods.bluewoodsart.chatgpt.site/go/david",
      "permanent": false
    },
    {
      "source": "/banners/labor-day",
      "destination": "https://master-front-end-blue-woods.bluewoodsart.chatgpt.site/banners/labor-day",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/services/images/:path*",
      "destination": "/services/images/:path*"
    },
    {
      "source": "/services/service-page.js",
      "destination": "/services/service-page.js"
    },
    {
      "source": "/services/vehicle-wraps",
      "destination": "/services/vehicle-wraps.html"
    },
    {
      "source": "/services/custom-banners",
      "destination": "/services/custom-banners.html"
    },
    {
      "source": "/services/vehicle-magnets",
      "destination": "/services/vehicle-magnets.html"
    },
    {
      "source": "/services/stickers-decals",
      "destination": "/services/stickers-decals.html"
    },
    {
      "source": "/services/business-signs",
      "destination": "/services/business-signs.html"
    },
    {
      "source": "/services/window-graphics",
      "destination": "/services/window-graphics.html"
    },
    {
      "source": "/services/services.css",
      "destination": "/services/services.css"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/stickers/generator.js",
      "destination": "/stickers/generator.js"
    },
    {
      "source": "/api/sticker-store",
      "destination": "/api/download-pdf?sticker_store=1"
    },
    {
      "source": "/stickers/checkout.js",
      "destination": "/stickers/checkout.js"
    },
    {
      "source": "/stickers",
      "destination": "/stickers/index.html"
    },
    {
      "source": "/stickers/:path*",
      "destination": "/stickers/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/download-pdf.ts": {
      "maxDuration": 180
    }
  },
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/rep/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/proof/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/invoice/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/designer/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/upload-assets/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/client-video-upload/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/logout",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/register",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/thank-you",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/confirmation",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin-status",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/test-short-intake",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/compassion-backend-proof",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/service-quote",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
